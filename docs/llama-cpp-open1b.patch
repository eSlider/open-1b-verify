@@ -0,0 +1,52 @@
+from __future__ import annotations
+
+from typing import Iterable, TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from torch import Tensor
+
+from .base import ModelBase, TextModel, gguf, logger
+
+
+@ModelBase.register("Open1BForCausalLM")
+@ModelBase.example("Gensyn/open-1b-sft")
+class Open1BModel(TextModel):
+    model_arch = gguf.MODEL_ARCH.OPEN1B
+
+    def get_vocab_base_pre(self, tokenizer) -> str:
+        # open-1b's tokenizer.json declares a `<Split>` step whose pattern is
+        # serialized with the "String" variant (a literal `\d`, not a regex),
+        # so it is a no-op and the effective pre-tokenizer is plain byte-level
+        # BPE with the GPT-2 regex. That is exactly llama.cpp's "gpt-2" pre.
+        return "gpt-2"
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+
+        sliding_window = self.hparams["sliding_window"]
+        self.gguf_writer.add_sliding_window(sliding_window)
+        logger.info(f"gguf: sliding window = {sliding_window}")
+
+        # open-1b is full-causal on the last layer of every `swa_full_every`
+        # group and on the final layer; the runtime applies that exact pattern.
+        swa_full_every = self.hparams["swa_full_every"]
+        self.gguf_writer.add_sliding_window_pattern(swa_full_every)
+        logger.info(f"gguf: sliding window pattern period = {swa_full_every}")
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        # LSQ per-channel weight scales are not materialised: the released
+        # master weights are used directly, equivalent to quantized_forward=false.
+        if name.endswith(".weight_scale"):
+            return
+
+        # the checkpoint stores a fused gate+up projection; split it for ggml
+        if name.endswith("ffn.w_gate_up.weight"):
+            assert bid is not None
+            n_ff = data_torch.shape[0] // 2
+            gate = data_torch[:n_ff].contiguous()
+            up   = data_torch[n_ff:].contiguous()
+            yield (self.format_tensor_name(gguf.MODEL_TENSOR.FFN_GATE, bid), gate)
+            yield (self.format_tensor_name(gguf.MODEL_TENSOR.FFN_UP,   bid), up)
+            return
+
+        yield from super().modify_tensors(data_torch, name, bid)
